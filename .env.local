COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
WEB_PORT=41300
GATEWAY_PORT=41800
ADMIN_PORT=41900
POSTGRES_PORT=15432
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
REDIS_PORT=16379

POSTGRES_ADMIN_USER=myunivokai_admin
POSTGRES_ADMIN_PASSWORD=myunivokai_local_admin
DNA_DATABASE_NAME=myunivokai_dna
DNA_DATABASE_USER=myunivokai_dna_app
DNA_DATABASE_PASSWORD=myunivokai_local_dna
UNIVERSE_DATABASE_NAME=myunivokai_universe
UNIVERSE_DATABASE_USER=myunivokai_universe_app
UNIVERSE_DATABASE_PASSWORD=myunivokai_local_universe
NATURE_DATABASE_NAME=myunivokai_nature
NATURE_DATABASE_USER=myunivokai_nature_app
NATURE_DATABASE_PASSWORD=myunivokai_local_nature
OCEAN_DATABASE_NAME=myunivokai_ocean
OCEAN_DATABASE_USER=myunivokai_ocean_app
OCEAN_DATABASE_PASSWORD=myunivokai_local_ocean
AUTH_DATABASE_NAME=myunivokai_auth
AUTH_DATABASE_USER=myunivokai_auth_app
AUTH_DATABASE_PASSWORD=myunivokai_local_auth

NATS_URL=nats://nats:4222
NATS_GATEWAY_USERNAME=myunivokai_gateway
NATS_GATEWAY_PASSWORD=myunivokai_local_gateway
NATS_DNA_USERNAME=myunivokai_dna
NATS_DNA_PASSWORD=myunivokai_local_dna
NATS_UNIVERSE_USERNAME=myunivokai_universe
NATS_UNIVERSE_PASSWORD=myunivokai_local_universe
NATS_NATURE_USERNAME=myunivokai_nature
NATS_NATURE_PASSWORD=myunivokai_local_nature
NATS_OCEAN_USERNAME=myunivokai_ocean
NATS_OCEAN_PASSWORD=myunivokai_local_ocean
NATS_AUTH_USERNAME=myunivokai_auth
NATS_AUTH_PASSWORD=myunivokai_local_auth
NATS_TELEMETRY_USERNAME=myunivokai_telemetry
NATS_TELEMETRY_PASSWORD=myunivokai_local_telemetry
NATS_BOOTSTRAP_USERNAME=myunivokai_bootstrap
NATS_BOOTSTRAP_PASSWORD=myunivokai_local_bootstrap

# Off in .env.example's shipped default (matches production, opt-in only).
# This file drives `make local-up`'s whole stack, and with it left unset here
# api-gateway's compose fragment falls back to TELEMETRY_ENABLED=false, so the
# admin Telemetry screens (Traffic/Performance/Reliability) have nothing to
# render — not a bug in that pipeline, just never-fed. Local containers do not
# sleep and this data holds nothing sensitive, so there is no cost to leaving
# it on here.
TELEMETRY_ENABLED=true

REDIS_PASSWORD=myunivokai_local_redis
REDIS_URL=redis://:myunivokai_local_redis@redis:6379/0
REDIS_KEY_PREFIX=myunivokai
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s

ADMIN_ROUTES_ENABLED=true
ADMIN_ALLOWED_ORIGIN=http://localhost:41900
ADMIN_RATE_LIMIT_REQUESTS_PER_SECOND=10
ADMIN_RATE_LIMIT_BURST=50
ADMIN_GATEWAY_BASE_URL=http://api-gateway:41800
# Public half of the AUTH_ACCESS_PRIVATE_KEY seed above — throwaway local-only
# value, never valid in any deployed environment.
ADMIN_ACCESS_PUBLIC_KEYS=LevwVSKfMJY075I8dtGksiMif1pouqn7aisvsZPiARI=
ADMIN_TOKEN_VERSION_CACHE_TTL=360h

NATS_REQUEST_TIMEOUT=3s
NATS_PUBLISH_TIMEOUT=5s
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_FETCH_BATCH_SIZE=1
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_QUERY_TIMEOUT=2500ms
SERVICE_SHUTDOWN_TIMEOUT=15s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# Throwaway local-only signing key — never used outside this Docker network,
# never valid in any deployed environment; see services/auth-service/README.md.
AUTH_ACCESS_PRIVATE_KEY=DqpJxFDKPBAtKTcKpCXuSq7LJj0bDD/eILTTuIM8c0E=
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=336h
AUTH_TOKEN_VERSION_CACHE_TTL=360h
AUTH_INVITE_TOKEN_TTL=168h
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_SALT_LENGTH=16
AUTH_ARGON2_KEY_LENGTH=32
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT=35s
AI_TOTAL_BUDGET=105s
AI_MAX_RETRIES=2
GEMINI_API_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:41800

# --- PostgreSQL: Analytics Service Database ---
# The admin read model (EPIC-S4-ANALYTICS-001). A second copy of production
# data, so it gets its own database and its own role: nothing in the product
# path reads it, and only analytics-service's event consumer writes it.
ANALYTICS_DATABASE_NAME=myunivokai_analytics
ANALYTICS_DATABASE_USER=myunivokai_analytics_app
ANALYTICS_DATABASE_PASSWORD=myunivokai_local_analytics

# --- NATS: Analytics Service ---
# The only user that subscribes to myunivokai.events.> as a wildcard, and the
# only one with no domain publish permission at all — see the analytics block
# in infra/nats/nats-server.conf.
NATS_ANALYTICS_USERNAME=myunivokai_analytics
NATS_ANALYTICS_PASSWORD=myunivokai_local_analytics

# --- Analytics Service: event consumer ---
# A projection is one small upsert rather than a long scene build, so a larger
# fetch batch than the family services use keeps the read model close to real
# time after a restart replays a backlog.
ANALYTICS_FETCH_BATCH_SIZE=25
