COMPOSE_PROJECT_NAME=myunivokai-local
POSTGRES_PORT=15432
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
REDIS_PORT=16379
POSTGRES_ADMIN_USER=myunivokai_admin
POSTGRES_ADMIN_PASSWORD=myunivokai_local_admin
DNA_DATABASE_NAME=myunivokai_dna
DNA_DATABASE_USER=myunivokai_dna_app
DNA_DATABASE_PASSWORD=myunivokai_local_dna
UNIVERSE_DATABASE_NAME=myunivokai_universe
UNIVERSE_DATABASE_USER=myunivokai_universe_app
UNIVERSE_DATABASE_PASSWORD=myunivokai_local_universe
NATURE_DATABASE_NAME=myunivokai_nature
NATURE_DATABASE_USER=myunivokai_nature_app
NATURE_DATABASE_PASSWORD=myunivokai_local_nature
NATS_GATEWAY_USERNAME=myunivokai_gateway
NATS_GATEWAY_PASSWORD=myunivokai_local_gateway
NATS_DNA_USERNAME=myunivokai_dna
NATS_DNA_PASSWORD=myunivokai_local_dna
NATS_UNIVERSE_USERNAME=myunivokai_universe
NATS_UNIVERSE_PASSWORD=myunivokai_local_universe
NATS_NATURE_USERNAME=myunivokai_nature
NATS_NATURE_PASSWORD=myunivokai_local_nature
NATS_BOOTSTRAP_USERNAME=myunivokai_bootstrap
NATS_BOOTSTRAP_PASSWORD=myunivokai_local_bootstrap
REDIS_PASSWORD=myunivokai_local_redis

# --- PostgreSQL: Auth Service Database ---
# Added late: auth-service landed after this file was written, so a standalone
# `infra` run was relying purely on the compose-file defaults to create it.
AUTH_DATABASE_NAME=myunivokai_auth
AUTH_DATABASE_USER=myunivokai_auth_app
AUTH_DATABASE_PASSWORD=myunivokai_local_auth

# --- PostgreSQL: Analytics Service Database ---
ANALYTICS_DATABASE_NAME=myunivokai_analytics
ANALYTICS_DATABASE_USER=myunivokai_analytics_app
ANALYTICS_DATABASE_PASSWORD=myunivokai_local_analytics

# --- NATS: Auth and Analytics users (must match nats-server.conf ACL) ---
NATS_AUTH_USERNAME=myunivokai_auth
NATS_AUTH_PASSWORD=myunivokai_local_auth
NATS_ANALYTICS_USERNAME=myunivokai_analytics
NATS_ANALYTICS_PASSWORD=myunivokai_local_analytics
