# =============================================================================
# Myunivokai — Root Environment File (.env.example)
# =============================================================================
# This file is used by the ROOT docker-compose-local.yaml to run the FULL STACK.
# Copy this file to .env.local and adjust values as needed.
#
#   cp .env.example .env.local
#
# The root compose aggregator passes .env.local to every included compose file:
#   - infra/docker-compose-local.yaml   (PostgreSQL, NATS, Redis)
#   - services/*/docker-compose-local.yaml (Gateway, DNA, Universe, Nature)
#   - apps/myunivokai-personalization/docker-compose-local.yaml (Next.js frontend)
# =============================================================================

# --- Compose Project ---
COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development

# --- Host Ports (mapped to localhost) ---
WEB_PORT=41300
GATEWAY_PORT=41800
# Reserved for apps/myunivokai-admin (not yet scaffolded — S4-AUTH-004); only
# used today as the gateway's ADMIN_ALLOWED_ORIGIN below.
ADMIN_PORT=41900
POSTGRES_PORT=15432
NATS_CLIENT_PORT=14222
NATS_MONITOR_PORT=18222
REDIS_PORT=16379

# --- PostgreSQL: Admin ---
POSTGRES_ADMIN_USER=myunivokai_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin

# --- PostgreSQL: DNA Service Database ---
DNA_DATABASE_NAME=myunivokai_dna
DNA_DATABASE_USER=myunivokai_dna_app
DNA_DATABASE_PASSWORD=change_me_dna

# --- PostgreSQL: Universe Service Database ---
UNIVERSE_DATABASE_NAME=myunivokai_universe
UNIVERSE_DATABASE_USER=myunivokai_universe_app
UNIVERSE_DATABASE_PASSWORD=change_me_universe

# --- PostgreSQL: Nature Service Database ---
NATURE_DATABASE_NAME=myunivokai_nature
NATURE_DATABASE_USER=myunivokai_nature_app
NATURE_DATABASE_PASSWORD=change_me_nature

# --- PostgreSQL: Ocean Service Database ---
OCEAN_DATABASE_NAME=myunivokai_ocean
OCEAN_DATABASE_USER=myunivokai_ocean_app
OCEAN_DATABASE_PASSWORD=change_me_ocean

# --- PostgreSQL: Auth Service Database ---
AUTH_DATABASE_NAME=myunivokai_auth
AUTH_DATABASE_USER=myunivokai_auth_app
AUTH_DATABASE_PASSWORD=change_me_auth

# --- PostgreSQL: Analytics Service Database ---
# The admin read model. A second copy of production data, so it is a separate
# database with its own role: nothing in the product path may read it, and
# nothing but analytics-service's event consumer may write it.
ANALYTICS_DATABASE_NAME=myunivokai_analytics
ANALYTICS_DATABASE_USER=myunivokai_analytics_app
ANALYTICS_DATABASE_PASSWORD=change_me_analytics

# --- PostgreSQL: Telemetry Service Database ---
# Operations data about the platform itself - request counts, latency
# histograms, cache hit rates - owned entirely by telemetry-service. It holds
# no user data at all, which is why it is a separate database rather than a
# schema inside the analytics one.
TELEMETRY_DATABASE_NAME=myunivokai_telemetry
TELEMETRY_DATABASE_USER=myunivokai_telemetry_app
TELEMETRY_DATABASE_PASSWORD=change_me_telemetry

# --- NATS: Connection ---
# Inside Docker network, services connect to nats:4222.
NATS_URL=nats://nats:4222

# --- NATS: Per-Service Credentials (must match nats-server.conf ACL) ---
# Local development only. Deployed environments authenticate to Synadia Cloud
# with a nats.creds file (NATS_CREDENTIALS) and share ONE account user across
# every service, so none of the pairs below are set there — and no publish
# allow-list is enforced there either. infra/nats/nats-server.conf is the only
# place these permissions actually apply. See
# agent-system/skills/production-deployment-guide.md.
NATS_GATEWAY_USERNAME=myunivokai_gateway
NATS_GATEWAY_PASSWORD=change_me_gateway
NATS_DNA_USERNAME=myunivokai_dna
NATS_DNA_PASSWORD=change_me_dna
NATS_UNIVERSE_USERNAME=myunivokai_universe
NATS_UNIVERSE_PASSWORD=change_me_universe
NATS_NATURE_USERNAME=myunivokai_nature
NATS_NATURE_PASSWORD=change_me_nature
NATS_OCEAN_USERNAME=myunivokai_ocean
NATS_OCEAN_PASSWORD=change_me_ocean
NATS_AUTH_USERNAME=myunivokai_auth
NATS_AUTH_PASSWORD=change_me_auth
# The only user that subscribes to myunivokai.events.> as a wildcard, and the
# only one with no domain publish permission at all.
NATS_ANALYTICS_USERNAME=myunivokai_analytics
NATS_ANALYTICS_PASSWORD=change_me_analytics
NATS_TELEMETRY_USERNAME=myunivokai_telemetry
NATS_TELEMETRY_PASSWORD=change_me_telemetry
NATS_BOOTSTRAP_USERNAME=myunivokai_bootstrap
NATS_BOOTSTRAP_PASSWORD=change_me_bootstrap

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379/0
REDIS_KEY_PREFIX=myunivokai

# --- Gateway: Rate Limiting & Cache TTLs ---
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s

# --- Gateway: /api/admin route group (S4-AUTH-003) ---
# Off by default in production until apps/myunivokai-admin exists; local dev
# turns it on. See agent-system/plans/services/auth-and-admin-plan.md#amended--one-gateway-two-route-groups.
ADMIN_ROUTES_ENABLED=true
ADMIN_ALLOWED_ORIGIN=http://localhost:41900
ADMIN_RATE_LIMIT_REQUESTS_PER_SECOND=10
ADMIN_RATE_LIMIT_BURST=50
# Public half of AUTH_ACCESS_PRIVATE_KEY (services/auth-service/.env.example) —
# derive with `openssl pkey` from the seed, or the small Go snippet in
# services/auth-service/README.md#key-rotation. Comma-separated for rotation
# (S4-AUTH-005): list the new key alongside the outgoing one until every
# session has re-authenticated, then remove the old one.
ADMIN_ACCESS_PUBLIC_KEYS=
ADMIN_TOKEN_VERSION_CACHE_TTL=360h

# --- Admin App (S4-AUTH-004) ---
# Only this app's own server ever calls the gateway (see its BFF route
# handlers under src/app/api/admin/auth); the Docker service name resolves
# inside the shared network, unlike ADMIN_ALLOWED_ORIGIN above, which the
# browser has to reach.
ADMIN_GATEWAY_BASE_URL=http://api-gateway:41800

# --- NATS: Messaging Timeouts (shared across services) ---
NATS_REQUEST_TIMEOUT=3s
NATS_PUBLISH_TIMEOUT=5s
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_FETCH_BATCH_SIZE=1
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_QUERY_TIMEOUT=2500ms

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# --- Telemetry (gateway rollups + telemetry-service) ---
# OFF by default, and that default is load-bearing rather than cautious: with
# it off the gateway registers no telemetry middleware, runs no ticker and
# publishes nothing, so the request path is exactly what it was before this
# existed. Turning it on is the only way any of it runs.
TELEMETRY_ENABLED=false
# How much traffic one published envelope summarises, and the bucket width
# every chart is drawn at. Changing it changes the resolution of history
# already stored, not only of history still to come.
TELEMETRY_FLUSH_INTERVAL=60s
# postgres | otlp, read once at startup by telemetry-service. postgres is the
# only sink the admin Telemetry screen can render from; otlp forwards to
# Grafana Cloud and answers no range query at all.
TELEMETRY_SINK=postgres
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_RETENTION_SWEEP_INTERVAL=6h
# TELEMETRY_SINK=otlp only. Authentication goes in the standard
# OTEL_EXPORTER_OTLP_HEADERS variable so Grafana's own snippet works unchanged.
TELEMETRY_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Where the Telemetry screen sends a reader when the sink stores nothing
# locally. Empty means nobody configured one, which the screen says plainly.
TELEMETRY_DASHBOARD_URL=

# --- Auth Service ---
# 32-byte Ed25519 seed, base64-encoded (e.g. `openssl rand -base64 32`).
# NEVER commit a real value; see services/auth-service/README.md.
AUTH_ACCESS_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=336h
AUTH_TOKEN_VERSION_CACHE_TTL=360h
AUTH_INVITE_TOKEN_TTL=168h
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_SALT_LENGTH=16
AUTH_ARGON2_KEY_LENGTH=32
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
# cmd/bootstrap only; supply at invocation, never a committed default.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# --- AI Provider (used by dna-service only) ---
# Options: mock | gemini | openai
# "mock" requires no API key and is recommended for local development.
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
AI_ENABLE_FALLBACK=true
AI_TIMEOUT=35s
AI_TOTAL_BUDGET=105s
AI_MAX_RETRIES=2
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Frontend ---
# The browser uses this URL to call the API Gateway.
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:41800
