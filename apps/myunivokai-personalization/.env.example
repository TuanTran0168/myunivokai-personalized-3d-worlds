# =============================================================================
# Myunivokai Web — Environment File (.env.example)
# =============================================================================
# Used by apps/myunivokai-personalization/docker-compose-local.yaml (standalone mode)
# and also by Next.js when running with `npm run dev` on the host.
#
#   cp .env.example .env.local
# =============================================================================

# --- Frontend ---
# The browser uses this URL to reach the API Gateway.
# Use http://localhost:41800 for local development.
# In production (Render/Vercel), set to the Gateway's public URL.
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:41800

# --- Renderer rollout ---
# LEAVE THIS UNSET. Unset is the shipping configuration: WebGPURenderer wherever
# the browser reports a real WebGPU adapter, WebGLRenderer everywhere else.
#
# It is listed here because the two values that DO something are worth knowing
# before an incident rather than during one:
#
#   NEXT_PUBLIC_NODE_RENDERER=0              kill switch. Also 'off', 'false',
#                                            'no', 'disabled'. Puts every
#                                            visitor back on WebGLRenderer.
#   NEXT_PUBLIC_NODE_RENDERER=every-visitor  WebGPURenderer even where WebGPU is
#                                            absent, which means its WebGL2
#                                            backend — 13.6 s of blocked main
#                                            thread on the forest's first mount
#                                            against WebGLRenderer's 3.6 s. For
#                                            measuring that backend in a real
#                                            deployment, never for shipping.
#
# NEXT_PUBLIC_* is inlined by Next AT BUILD TIME, so changing either one needs a
# rebuild and redeploy of the frontend, not just an environment edit.
# NEXT_PUBLIC_NODE_RENDERER=
