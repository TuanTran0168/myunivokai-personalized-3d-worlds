# =============================================================================
# Myunivokai Admin — Environment File (.env.example)
# =============================================================================
# Used by apps/myunivokai-admin/docker-compose-local.yaml (standalone mode)
# and also by Next.js when running with `npm run dev` on the host.
#
#   cp .env.example .env.local
# =============================================================================

# --- Server (this app's own server, never the browser, calls the gateway) ---
# Use http://localhost:41800 when running `npm run dev` on the host; inside
# the Docker network, use the gateway service's own name (see the root
# .env.example's ADMIN_GATEWAY_BASE_URL).
ADMIN_GATEWAY_BASE_URL=http://localhost:41800
