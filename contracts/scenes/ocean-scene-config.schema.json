{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://myunivokai.com/contracts/scenes/ocean-scene-config.schema.json",
  "title": "OceanSceneConfig",
  "description": "Scene contract for the ocean family, produced by ocean-service (sceneType 'ocean', schemaVersion '1.4'). Renderers are keyed by (sceneType, schemaVersion). Only semantic and hero placements are stored; mass scatter (flora, marine snow, plankton, school paths) is derived frontend-side from the placement/path seeds embedded here. The whole water and lighting section is DERIVED from depth.metres by services/ocean-service/internal/services/depth_curve.go and then stored, so re-tuning the curve never changes a world that already exists. There is no hdriKey anywhere: the sky, where a world has one, is evaluated analytically (Preetham) rather than sampled, and below the waterline there is no sky to sample at all. Golden fixtures in services/ocean-service/internal/services/testdata are the executable form of this contract.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sceneType",
    "sceneName",
    "archetype",
    "quote",
    "theme",
    "palette",
    "depth",
    "water",
    "lighting",
    "seafloor",
    "current",
    "flora",
    "fauna",
    "bioluminescence",
    "landmarks",
    "camera",
    "postFX",
    "hud",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4"
    },
    "sceneType": {
      "const": "ocean"
    },
    "sceneName": {
      "type": "string"
    },
    "archetype": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "required": [
        "background",
        "primary",
        "secondary",
        "accent",
        "gradient"
      ],
      "properties": {
        "background": {
          "$ref": "#/definitions/hexColor"
        },
        "primary": {
          "$ref": "#/definitions/hexColor"
        },
        "secondary": {
          "$ref": "#/definitions/hexColor"
        },
        "accent": {
          "$ref": "#/definitions/hexColor"
        },
        "gradient": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hexColor"
          }
        }
      }
    },
    "depth": {
      "type": "object",
      "description": "This family's main axis. metres is authoritative and zone is derived from it, so the two can never disagree. The zone boundaries are physical constants of the depth curve, not round numbers: the sunlit shallows end where orange dies (40 m) and the twilight reach ends at the sunlight floor (1000 m). blendTowardZone/blendAmount model the transitional world the same way the forest's season does, except the stack does not wrap: there is nothing above the surface and nothing below the abyss.",
      "required": [
        "metres",
        "zone",
        "seafloorMetres"
      ],
      "properties": {
        "metres": {
          "type": "number",
          "description": "How deep the VIEWER is. NEGATIVE means above the waterline, by that many metres — depth is this family's axis and the axis continues through zero, so surfacing is a depth rather than a mode. The renderer branches on the sign because air is a different optical medium, not water with different numbers. Only shallow worlds surface, and only to a person's eye height.",
          "minimum": -24,
          "maximum": 3800
        },
        "seafloorMetres": {
          "type": "number",
          "description": "How deep the SEABED is here, against metres which is how deep the viewer is. Their difference is the water below; a floor is drawn only when it is smaller than water.visibilityMetres. Mean ocean depth is 3682 m, so midwater worlds legitimately carry values in the thousands.",
          "minimum": 3,
          "maximum": 11000
        },
        "zone": {
          "enum": [
            "sunlitShallows",
            "twilightReach",
            "abyss"
          ]
        },
        "blendTowardZone": {
          "enum": [
            "sunlitShallows",
            "twilightReach",
            "abyss"
          ]
        },
        "blendAmount": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.6
        }
      }
    },
    "water": {
      "type": "object",
      "description": "The water's OPTICS are entirely derived from depth by the depth curve, then stored, so two worlds at the same depth carry the same colour by construction. Two things are deliberately not: jerlovWaterType is clarity (geography) and windSpeedMetresPerSecond is weather, and neither follows from how deep a world is.",
      "required": [
        "fogColor",
        "fogDensity",
        "visibilityMetres",
        "tintStrength",
        "jerlovWaterType",
        "windSpeedMetresPerSecond"
      ],
      "properties": {
        "fogColor": {
          "$ref": "#/definitions/hexColor"
        },
        "fogDensity": {
          "type": "number",
          "minimum": 0.011,
          "maximum": 0.084
        },
        "visibilityMetres": {
          "type": "number",
          "description": "How far a viewer can actually see: the SHORTER of the two limits, how much light is left and how clear the water is. A trench is gin-clear and unlit; a harbour is brilliantly lit and opaque.",
          "minimum": 11.85,
          "maximum": 71
        },
        "tintStrength": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.95
        },
        "jerlovWaterType": {
          "type": "string",
          "description": "Jerlov's 1976 optical class of seawater — I to III for open ocean, 1C to 9C for coastal. Decides hue, the per-channel depth curve and how coherent a caustic pattern can still be, none of which one visibility number can answer. Open-water zones are never coastal: the turbidity that makes coastal water coastal is river outflow and resuspended sediment, and neither reaches the middle of an ocean.",
          "enum": ["I", "IA", "IB", "II", "III", "1C", "3C", "5C", "7C", "9C"]
        },
        "windSpeedMetresPerSecond": {
          "type": "number",
          "description": "Wind at 10 m above the sea — the number every marine forecast, buoy and wave-spectrum paper uses. The whole surface comes out of it: significant wave height (Pierson-Moskowitz 1964), peak wavelength, and whitecap coverage (Monahan & O'Muircheartaigh 1980). Bounded to Beaufort 3-6: below it the sea is a mirror with no wave field, above it every world is a storm.",
          "minimum": 5,
          "maximum": 13
        }
      }
    },
    "lighting": {
      "type": "object",
      "description": "No sun position, because the sun is not in the scene: surfaceElevationRadians is the angle daylight enters the water at. godRayStrength and causticStrength reach zero on their own as depth crosses the sunlight floor — nothing anywhere switches them off, which is why one renderer covers a sunlit reef and an abyssal trench without a mode flag.",
      "required": [
        "surfaceLightColor",
        "surfaceElevationRadians",
        "godRayStrength",
        "causticStrength",
        "ambientColor",
        "exposure"
      ],
      "properties": {
        "surfaceLightColor": {
          "$ref": "#/definitions/hexColor"
        },
        "surfaceElevationRadians": {
          "type": "number",
          "minimum": 0.06,
          "maximum": 1.3
        },
        "godRayStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "causticStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambientColor": {
          "$ref": "#/definitions/hexColor"
        },
        "exposure": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.45
        }
      }
    },
    "seafloor": {
      "type": "object",
      "required": [
        "placementSeed",
        "basinRadius",
        "ridgeAmplitude",
        "ridgeFrequency",
        "rockCount",
        "sedimentTuftCountDesktop",
        "sedimentTuftCountMobile"
      ],
      "properties": {
        "placementSeed": {
          "type": "string"
        },
        "basinRadius": {
          "type": "number",
          "minimum": 26,
          "maximum": 38
        },
        "ridgeAmplitude": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3.8
        },
        "ridgeFrequency": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.07
        },
        "rockCount": {
          "type": "integer",
          "minimum": 10,
          "maximum": 24
        },
        "sedimentTuftCountDesktop": {
          "type": "integer",
          "minimum": 400,
          "maximum": 900
        },
        "sedimentTuftCountMobile": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        }
      }
    },
    "current": {
      "type": "object",
      "description": "The forest's wind, one medium denser. Surge is a surface phenomenon and is almost absent from the abyss, because the energy driving it is. Marine snow is present at every depth — unlike the forest's four mutually exclusive seasonal particle systems, there is always something falling through seawater.",
      "required": [
        "kind",
        "intensity",
        "directionRadians",
        "gustFrequency",
        "marineSnowCountDesktop",
        "marineSnowCountMobile"
      ],
      "properties": {
        "kind": {
          "enum": [
            "still",
            "drift",
            "surge"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "directionRadians": {
          "type": "number",
          "minimum": 0,
          "maximum": 6.29
        },
        "gustFrequency": {
          "type": "number",
          "minimum": 0.18,
          "maximum": 0.52
        },
        "marineSnowCountDesktop": {
          "type": "integer",
          "minimum": 900,
          "maximum": 1800
        },
        "marineSnowCountMobile": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        }
      }
    },
    "flora": {
      "type": "object",
      "description": "Photosynthetic species (kelp, seagrass, hard corals) appear only where there is light to feed them. The abyss carries tubeworms, glass sponges and sea pens, which live on vent chemistry or filter-feeding instead.",
      "required": [
        "placementSeed",
        "countDesktop",
        "countMobile",
        "speciesMix",
        "scaleMin",
        "scaleMax",
        "swayStrength",
        "depthTintStrength"
      ],
      "properties": {
        "placementSeed": {
          "type": "string"
        },
        "countDesktop": {
          "type": "integer",
          "minimum": 40,
          "maximum": 260
        },
        "countMobile": {
          "type": "integer",
          "minimum": 0,
          "maximum": 260
        },
        "speciesMix": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "modelKey",
              "weight"
            ],
            "properties": {
              "modelKey": {
                "enum": [
                  "flora-kelp-giant",
                  "flora-seagrass",
                  "flora-coral-brain",
                  "flora-coral-staghorn",
                  "flora-coral-soft",
                  "flora-anemone",
                  "flora-tubeworm",
                  "flora-glass-sponge",
                  "flora-sea-pen"
                ]
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "scaleMin": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 0.9
        },
        "scaleMax": {
          "type": "number",
          "minimum": 1.25,
          "maximum": 1.7
        },
        "swayStrength": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "depthTintStrength": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 0.95
        }
      }
    },
    "fauna": {
      "type": "object",
      "required": [
        "schools",
        "drifters",
        "giants"
      ],
      "properties": {
        "schools": {
          "type": "array",
          "description": "cohesion and separation are what make a school move as one body instead of as N fish on parallel rails. Depth bands are metres ABOVE the seafloor, so a school keeps its height over the floor as the floor rises and falls.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "modelKey",
              "count",
              "pathSeed",
              "depthBandMin",
              "depthBandMax",
              "swimSpeed",
              "cohesion",
              "separation"
            ],
            "properties": {
              "modelKey": {
                "enum": [
                  "fish-reef-school",
                  "fish-silverside",
                  "fish-barracuda",
                  "fish-ray",
                  "fish-lanternfish",
                  "fish-hatchetfish"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 9,
                "maximum": 24
              },
              "pathSeed": {
                "type": "string"
              },
              "depthBandMin": {
                "type": "number",
                "minimum": 1.5,
                "maximum": 10.5
              },
              "depthBandMax": {
                "type": "number",
                "minimum": 4,
                "maximum": 18.5
              },
              "swimSpeed": {
                "type": "number",
                "minimum": 0.35,
                "maximum": 0.9
              },
              "cohesion": {
                "type": "number",
                "minimum": 0.45,
                "maximum": 0.85
              },
              "separation": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 0.6
              }
            }
          }
        },
        "drifters": {
          "type": "array",
          "description": "The jellyfish and siphonophore layer: things that pulse rather than swim, and the only creatures carrying their own light at every depth.",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "modelKey",
              "count",
              "pathSeed",
              "pulseRate",
              "emissiveColor"
            ],
            "properties": {
              "modelKey": {
                "enum": [
                  "drifter-moon-jelly",
                  "drifter-comb-jelly",
                  "drifter-siphonophore"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 4,
                "maximum": 12
              },
              "pathSeed": {
                "type": "string"
              },
              "pulseRate": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 0.7
              },
              "emissiveColor": {
                "$ref": "#/definitions/hexColor"
              }
            }
          }
        },
        "giants": {
          "type": "array",
          "description": "At most one per world. approachDistance is anchored to the water's own visibilityMetres rather than a fixed number, so a giant is always a silhouette arriving out of the fog: far away near the surface, uncomfortably close in the abyss.",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "modelKey",
              "passSeed",
              "approachDistance",
              "passDurationSeconds"
            ],
            "properties": {
              "modelKey": {
                "enum": [
                  "giant-manta",
                  "giant-whale-shark",
                  "giant-humpback",
                  "giant-sperm-whale"
                ]
              },
              "passSeed": {
                "type": "string"
              },
              "approachDistance": {
                "type": "number",
                "minimum": 9,
                "maximum": 57.37
              },
              "passDurationSeconds": {
                "type": "number",
                "minimum": 22,
                "maximum": 42
              }
            }
          }
        }
      }
    },
    "bioluminescence": {
      "type": "object",
      "description": "Rises as sunlight falls. bloomIntensity brightens light that is already in the scene and is never what makes it visible: an abyssal world has to read with post-processing switched off.",
      "required": [
        "planktonCount",
        "bloomIntensity",
        "emissiveColors",
        "flickerSeed"
      ],
      "properties": {
        "planktonCount": {
          "type": "integer",
          "minimum": 120,
          "maximum": 1400
        },
        "bloomIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emissiveColors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/hexColor"
          }
        },
        "flickerSeed": {
          "type": "string"
        }
      }
    },
    "landmarks": {
      "type": "array",
      "description": "One per Ocean DNA landmark — the clickable POI layer. The first is always the kelp cathedral. Placement is polar around the basin centre, plus heightAboveFloor, which is the one field the forest has no use for: an ocean is a volume.",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "meaning",
          "kind",
          "angleRadians",
          "radiusFromCenter",
          "heightAboveFloor",
          "accentColor",
          "energy"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "kelpCathedral",
              "sunkenRelic",
              "hydrothermalVent",
              "coralGarden",
              "abyssalTrench",
              "whaleFall"
            ]
          },
          "angleRadians": {
            "type": "number",
            "minimum": -0.3,
            "maximum": 6.6
          },
          "radiusFromCenter": {
            "type": "number",
            "minimum": 12,
            "maximum": 58
          },
          "heightAboveFloor": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "accentColor": {
            "$ref": "#/definitions/hexColor"
          },
          "energy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "distance",
        "fov"
      ],
      "properties": {
        "distance": {
          "type": "number",
          "minimum": 16,
          "maximum": 24
        },
        "fov": {
          "const": 55
        }
      }
    },
    "postFX": {
      "type": "object",
      "required": [
        "bloomIntensity",
        "grade"
      ],
      "properties": {
        "bloomIntensity": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.4
        },
        "grade": {
          "type": "object",
          "description": "Per-zone colour grade (table lookup, no PRNG draw).",
          "required": [
            "hueRadians",
            "saturation",
            "brightness",
            "contrast"
          ],
          "properties": {
            "hueRadians": {
              "type": "number"
            },
            "saturation": {
              "type": "number"
            },
            "brightness": {
              "type": "number"
            },
            "contrast": {
              "type": "number"
            }
          }
        }
      }
    },
    "hud": {
      "type": "object",
      "required": [
        "showTraitBars",
        "showLabels"
      ],
      "properties": {
        "showTraitBars": {
          "type": "boolean"
        },
        "showLabels": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Every model key the config references, in first-use order, plus the catalogue version that resolves them. The ocean-1 catalogue resolves each key to PROCEDURAL geometry built in the browser rather than to a downloaded GLB — see services/ocean-service/internal/services/ocean_scene_profile.go for why, and note that swapping a key to a self-hosted file later changes no stored config. There is deliberately no hdriKey: this family has no sky and no environment map.",
      "required": [
        "catalogVersion",
        "modelKeys"
      ],
      "properties": {
        "catalogVersion": {
          "const": "ocean-1"
        },
        "modelKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
