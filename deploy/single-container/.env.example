# Environment variables for deploy/single-container's image. Set these in
# Render's dashboard (Service -> Environment) exactly as render.yaml's
# `sync: false` entries are already set for the 8 separate services today —
# nothing here is a new secret, it is the same production configuration
# already described in notes/ops/production-deployment-guide.md, renamed
# per-service so eight binaries that each expect a generic
# DATABASE_URL/NATS_URL can share one container. See supervisord.conf for
# exactly how each name below gets remapped to the name the actual binary
# reads.

# --- The platform's one exposed port ---
# Must match the Dockerfile's EXPOSE (8080) and whatever port the platform is
# told to route to this container. Only api-gateway binds this; the other
# seven processes use fixed internal ports (8081-8087) that nothing outside
# the container ever reaches.
PORT=8080

# --- NATS (Synadia Cloud / NGS) — shared by all eight processes ---
NATS_URL=tls://connect.ngs.global:4222
# The FULL CONTENTS of the .creds file Synadia gives you (the file has
# -----BEGIN NATS USER JWT----- and -----BEGIN USER NKEY SEED----- blocks),
# pasted as one multi-line value. docker-entrypoint.sh writes this to
# /app/secrets/nats.creds at container start — see that file for why it is
# an env var and not a mounted secret file.
NATS_CREDS_CONTENT=

# --- Redis (Upstash) — shared by api-gateway and auth ---
REDIS_URL=rediss://:password@example.upstash.io:6379

# --- api-gateway ---
API_ALLOWED_ORIGINS=https://myunivokai.vercel.app
ADMIN_ROUTES_ENABLED=false
ADMIN_ALLOWED_ORIGIN=
# Public half of AUTH_ACCESS_PRIVATE_KEY below, never the private key
# itself. Comma-separated for key rotation.
ADMIN_ACCESS_PUBLIC_KEYS=
TELEMETRY_ENABLED=false

# --- Neon Postgres, one database per service (see notes/ops/production-deployment-guide.md §2.1) ---
# Each pair is Neon's pooled connection (DATABASE_URL) and its direct,
# non-pooled connection (DATABASE_DIRECT_URL, used for the migration every
# cmd/service main.go runs on its own boot).
DNA_DATABASE_URL=
DNA_DATABASE_DIRECT_URL=
UNIVERSE_DATABASE_URL=
UNIVERSE_DATABASE_DIRECT_URL=
NATURE_DATABASE_URL=
NATURE_DATABASE_DIRECT_URL=
OCEAN_DATABASE_URL=
OCEAN_DATABASE_DIRECT_URL=
AUTH_DATABASE_URL=
AUTH_DATABASE_DIRECT_URL=
ANALYTICS_DATABASE_URL=
ANALYTICS_DATABASE_DIRECT_URL=
TELEMETRY_DATABASE_URL=
TELEMETRY_DATABASE_DIRECT_URL=

# --- dna-service ---
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- universe-service / nature-service / ocean-service ---
# Printed VERBATIM into share URLs (ShareURL = PublicWebURL + "/share/" +
# slug — the service never appends its own family segment), so each one
# needs its own value with the right path already on it, exactly like
# render.yaml sets a different PUBLIC_WEB_URL per service today.
UNIVERSE_PUBLIC_WEB_URL=https://myunivokai.vercel.app/universe
NATURE_PUBLIC_WEB_URL=https://myunivokai.vercel.app/nature
OCEAN_PUBLIC_WEB_URL=https://myunivokai.vercel.app/ocean

# --- auth-service ---
# 32-byte Ed25519 seed, base64-encoded (`openssl rand -base64 32`). Generate
# ONE PER ENVIRONMENT — never reuse the local-dev value from the repo's own
# .env.example/.env.local, those are throwaway and committed on purpose.
AUTH_ACCESS_PRIVATE_KEY=

# --- telemetry-service ---
# Leave both blank unless TELEMETRY_SINK is switched to otlp in
# supervisord.conf (postgres is this deploy's default, matching render.yaml).
TELEMETRY_OTLP_ENDPOINT=
TELEMETRY_DASHBOARD_URL=
