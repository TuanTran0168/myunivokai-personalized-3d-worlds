# =============================================================================
# Telemetry Service — Environment File (.env.example)
# =============================================================================
# Used by services/telemetry-service/docker-compose-local.yaml (standalone
# mode). When running via the root docker-compose-local.yaml these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
#
# Note what is NOT here: no Redis URL, no signing key, no AI provider key.
# This service verifies no token, calls no provider and publishes no domain
# subject — a credential appearing here would be a sign it had started doing
# something it is not allowed to do.
# =============================================================================

# --- App ---
APP_ENV=development
# The health server's port. It exists so a scale-to-zero host has an inbound
# HTTP target to wake this process with, not for monitoring.
PORT=8080

# --- Sink selection ---
# postgres | otlp, read once at startup.
#
# postgres stores rollups in this repository's own schema and answers the admin
# Telemetry screen from it. otlp forwards them to Grafana Cloud and answers no
# range query at all — the screen then shows a link instead of charts.
#
# postgres is the default for two reasons: it is the only sink the admin app
# can render from, and the shipped configuration of every switch in this repo
# (AI_PROVIDER=mock, SERVICE_WAKE_PLATFORM=none) reaches nobody else's
# infrastructure until an operator opts in.
TELEMETRY_SINK=postgres

# --- Database (TELEMETRY_SINK=postgres only) ---
# Use postgres:5432 inside Docker, localhost:15432 outside Docker.
# DATABASE_DIRECT_URL is the unpooled endpoint migrations run against; on Neon
# the pooled one cannot execute DDL. Locally they are the same string.
DATABASE_URL=postgresql://myunivokai_telemetry_app:myunivokai_local_telemetry@postgres:5432/myunivokai_telemetry?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_telemetry_app:myunivokai_local_telemetry@postgres:5432/myunivokai_telemetry?sslmode=disable
DATABASE_MAX_CONNS=5

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
# This user may subscribe to myunivokai.events.telemetry.http.v1 and
# myunivokai.queries.telemetry.> and may publish no domain subject at all.
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_telemetry
NATS_PASSWORD=myunivokai_local_telemetry
NATS_CREDENTIALS=
NATS_CONNECT_TIMEOUT=5s
NATS_QUERY_TIMEOUT=2500ms

# --- Event consumer ---
# One envelope per minute per gateway instance, so the ack window is generous
# and the retry delay short: a failure here is a database blip, not a queue of
# work piling up.
NATS_ACK_WAIT=2m
NATS_MAX_ACK_PENDING=1000
NATS_RETRY_DELAY=2s

# --- Retention (TELEMETRY_SINK=postgres only) ---
# A delete, not a policy document. There is no rollup-of-rollups: a bucket is
# already one minute wide, so the only thing old data becomes is deleted.
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_RETENTION_SWEEP_INTERVAL=6h

# --- Grafana Cloud (TELEMETRY_SINK=otlp only) ---
# The OTLP gRPC endpoint. Authentication is supplied through the standard
# OTEL_EXPORTER_OTLP_HEADERS variable rather than a setting of our own, so
# Grafana's own copy-pasteable snippet works unchanged:
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instanceID:token>
TELEMETRY_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Where the admin Telemetry screen sends a reader when the sink stores nothing
# locally. Empty is legal and means "nobody configured one", which the screen
# states plainly rather than rendering a dead link.
TELEMETRY_DASHBOARD_URL=

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s

# Log level and filtering, the tracing crate's own syntax.
RUST_LOG=info
