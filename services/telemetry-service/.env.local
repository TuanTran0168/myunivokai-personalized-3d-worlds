COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
PORT=8080
TELEMETRY_SINK=postgres
DATABASE_URL=postgresql://myunivokai_telemetry_app:myunivokai_local_telemetry@postgres:5432/myunivokai_telemetry?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_telemetry_app:myunivokai_local_telemetry@postgres:5432/myunivokai_telemetry?sslmode=disable
DATABASE_MAX_CONNS=5
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_telemetry
NATS_PASSWORD=myunivokai_local_telemetry
NATS_CONNECT_TIMEOUT=5s
NATS_QUERY_TIMEOUT=2500ms
NATS_ACK_WAIT=2m
NATS_MAX_ACK_PENDING=1000
NATS_RETRY_DELAY=2s
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_RETENTION_SWEEP_INTERVAL=6h
SERVICE_SHUTDOWN_TIMEOUT=15s
RUST_LOG=info
