FROM golang:1.25-alpine AS builder
WORKDIR /workspace/services/nature-service
COPY contracts/go /workspace/contracts/go
COPY family-platform/go /workspace/family-platform/go
COPY services/nature-service/go.mod services/nature-service/go.sum ./
RUN go mod download
COPY services/nature-service .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/nature-service ./cmd/service && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates && addgroup -S app && adduser -S -G app app
COPY --from=builder --chown=app:app /out/nature-service /app/nature-service
COPY --from=builder --chown=app:app /out/migrate /app/migrate
COPY --from=builder --chown=app:app /workspace/services/nature-service/migrations /app/migrations
USER app:app
CMD ["/app/nature-service"]
