COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:41300/ocean
DATABASE_URL=postgresql://myunivokai_ocean_app:myunivokai_local_ocean@postgres:5432/myunivokai_ocean?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_ocean_app:myunivokai_local_ocean@postgres:5432/myunivokai_ocean?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_ocean
NATS_PASSWORD=myunivokai_local_ocean
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_FETCH_BATCH_SIZE=1
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_PUBLISH_TIMEOUT=5s
NATS_QUERY_TIMEOUT=2500ms
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
SERVICE_SHUTDOWN_TIMEOUT=15s
