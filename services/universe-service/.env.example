# =============================================================================
# Universe Service — Environment File (.env.example)
# =============================================================================
# Used by services/universe-service/docker-compose-local.yaml (standalone mode).
# When running via the root docker-compose-local.yaml, these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
# =============================================================================

# --- App ---
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:41300

# --- Database ---
# PostgreSQL connection string for the myunivokai_universe database.
# Use postgres:5432 inside Docker, localhost:15432 outside Docker.
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_MAX_CONNS=10

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CREDENTIALS=
NATS_ACK_WAIT=2m
NATS_MAX_DELIVER=5
NATS_FETCH_BATCH_SIZE=1
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_PUBLISH_TIMEOUT=5s
NATS_QUERY_TIMEOUT=2500ms

# --- Outbox (transactional outbox for NATS publishing) ---
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# --- Share ---
SHARE_SLUG_LENGTH=10

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s

# SERVICE_VERSION is what this process reports on
# myunivokai.events.<name>.service.started.v1, and what the admin Fleet screen
# shows. Left unset, a service falls back to Render's RENDER_GIT_COMMIT and then
# to the Go VCS stamp — which a container image does not carry, so a local run
# reports "unknown". `make local-up` exports the working tree's own
# `git describe --always --dirty` for exactly that reason.
SERVICE_VERSION=
