# =============================================================================
# Auth Service — Environment File (.env.example)
# =============================================================================
# Used by services/auth-service/docker-compose-local.yaml (standalone mode).
# When running via the root docker-compose-local.yaml, these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
# =============================================================================

# --- App ---
APP_ENV=development

# --- Database ---
# PostgreSQL connection string for the myunivokai_auth database.
# Use postgres:5432 inside Docker, localhost:15432 outside Docker.
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_MAX_CONNS=10

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CREDENTIALS=
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_QUERY_TIMEOUT=2500ms

# --- Redis ---
# The tokenVersion cache the gateway's revocation check reads. Reuses the
# same Redis instance and key prefix the gateway already uses.
REDIS_URL=
REDIS_KEY_PREFIX=myunivokai

# --- Tokens ---
# 32-byte Ed25519 seed, base64-encoded. Generate with:
#   openssl genpkey -algorithm ed25519 | openssl pkey -noout -text | ...
# or any Ed25519 seed generator. NEVER commit a real value here.
AUTH_ACCESS_PRIVATE_KEY=
AUTH_ACCESS_TOKEN_TTL=10m
AUTH_REFRESH_TOKEN_TTL=336h
AUTH_TOKEN_VERSION_CACHE_TTL=360h
# How long an invite link stays valid (S4-AUTH-005). No email infrastructure
# exists yet, so the operator relays the token manually within this window.
AUTH_INVITE_TOKEN_TTL=168h

# --- Passwords (Argon2id) ---
# OWASP minimum for a 512 MB free-plan instance. Raise only after measuring
# on the real instance size — see notes/plans/services/auth-and-admin-plan.md#passwords.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_ARGON2_SALT_LENGTH=16
AUTH_ARGON2_KEY_LENGTH=32

# --- Lockout ---
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m

# --- Bootstrap (cmd/bootstrap only; never set a default value here) ---
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s

# SERVICE_VERSION is what this process reports on
# myunivokai.events.<name>.service.started.v1, and what the admin Fleet screen
# shows. Left unset, a service falls back to Render's RENDER_GIT_COMMIT and then
# to the Go VCS stamp — which a container image does not carry, so a local run
# reports "unknown". `make local-up` exports the working tree's own
# `git describe --always --dirty` for exactly that reason.
SERVICE_VERSION=
