# =============================================================================
# API Gateway — Environment File (.env.example)
# =============================================================================
# Used by services/api-gateway/docker-compose-local.yaml (standalone mode).
# When running via the root docker-compose-local.yaml, these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
# =============================================================================

# --- App ---
APP_ENV=development
APP_NAME=Myunivokai API Gateway
API_HOST=0.0.0.0
API_PORT=41800
API_ALLOWED_ORIGINS=http://localhost:41300
TRUST_PROXY=false
MAX_REQUEST_BODY_BYTES=65536

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
NATS_URL=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_CREDENTIALS=
NATS_PUBLISH_TIMEOUT=5s
NATS_REQUEST_TIMEOUT=3s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s

# --- Redis ---
# Use redis://:password@redis:6379/0 inside Docker.
# Use redis://:password@localhost:16379/0 outside Docker.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=myunivokai

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20

# --- Admin route group (/api/admin) ---
# This block is NOT optional in standalone mode. The compose file defaults
# ADMIN_ROUTES_ENABLED to true, and enabling the group with an empty
# ADMIN_ACCESS_PUBLIC_KEYS or a wildcard ADMIN_ALLOWED_ORIGIN fails config
# validation — which stops the WHOLE gateway from starting, product routes
# included. Set ADMIN_ROUTES_ENABLED=false if you only want the product API.
ADMIN_ROUTES_ENABLED=true
# Exactly one origin, never a wildcard, in every environment including dev.
ADMIN_ALLOWED_ORIGIN=http://localhost:41900
ADMIN_RATE_LIMIT_REQUESTS_PER_SECOND=10
ADMIN_RATE_LIMIT_BURST=50
# The PUBLIC half of auth-service's AUTH_ACCESS_PRIVATE_KEY, never the private
# key itself. Comma-separated for rotation: list the new key alongside the
# outgoing one until every session has re-authenticated, then drop the old
# one — see notes/ops/admin-key-rotation-drill.md. The value below is the
# public half of the throwaway local-only seed committed in
# services/auth-service/docker-compose-local.yaml; it is never valid in any
# deployed environment.
ADMIN_ACCESS_PUBLIC_KEYS=LevwVSKfMJY075I8dtGksiMif1pouqn7aisvsZPiARI=
ADMIN_TOKEN_VERSION_CACHE_TTL=360h

# --- Response Cache TTLs ---
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s

# SERVICE_VERSION is what this process reports on
# myunivokai.events.<name>.service.started.v1, and what the admin Fleet screen
# shows. Left unset, a service falls back to Render's RENDER_GIT_COMMIT and then
# to the Go VCS stamp — which a container image does not carry, so a local run
# reports "unknown". `make local-up` exports the working tree's own
# `git describe --always --dirty` for exactly that reason.
SERVICE_VERSION=

# --- Service wake (scale-to-zero hosting only) ---
# Instances on a scale-to-zero plan wake only on inbound traffic, and every
# service behind this gateway is a pure NATS consumer that receives none. The
# gateway therefore starts them itself: it pings a sleeping service and answers
# 503 SERVICE_WAKING with Retry-After so the caller can come back, instead of
# holding the connection open for a 20-60 second cold start.
# See notes/vision/service-wake-mechanism.md.
#
# SERVICE_WAKE_PLATFORM picks the mechanism, the way AI_PROVIDER picks an AI
# adapter. An unknown value stops the gateway at startup rather than silently
# waking nothing.
#   none  Wake nobody. The default, and the permanently correct value on any
#         always-on host: a paid plan, a real background worker, a Kubernetes
#         Deployment. Leaving free tier is this one line, not a code change.
#   http  Wake by requesting the instance, which is how Render free, Koyeb,
#         Fly.io auto-start and Railway trial all behave. Reads the URLs below.
# Local Docker containers never sleep, so this stays "none" here.
SERVICE_WAKE_PLATFORM=none

# Public base URLs, used only by the "http" platform. Each is optional: a
# service with no URL is simply not wakeable, and the gateway keeps answering
# plain SERVICE_UNAVAILABLE for it rather than promising a wake it cannot
# deliver. Scheme and host are validated at startup, so a typo fails the deploy
# instead of becoming a silent no-op. No path — /healthz is appended.
#
# Supplying none of them is allowed and is what a first deploy looks like: the
# URLs have to be public, and on a scale-to-zero host they do not exist until
# the deploy that creates the services has finished. The gateway starts either
# way and logs which services it can actually reach on every boot — "service
# wake ready" with the list, at warn level whenever any is missing.
# DNA_SERVICE_URL=https://myunivokai-dna.onrender.com
# UNIVERSE_SERVICE_URL=https://myunivokai-universe.onrender.com
# NATURE_SERVICE_URL=https://myunivokai-nature.onrender.com
# AUTH_SERVICE_URL=https://myunivokai-auth.onrender.com
# ANALYTICS_SERVICE_URL=https://myunivokai-analytics.onrender.com
# TELEMETRY_SERVICE_URL=https://myunivokai-telemetry.onrender.com

# How long a wake call may take before the goroutine gives up. A cold start
# outlasts this by design — the wake is triggered by the connection arriving,
# not by the response, so a timeout here is normal and not an error.
SERVICE_WAKE_TIMEOUT=5s
# One burst of requests against a sleeping service should produce one wake, not
# one per request. Roughly a cold start long.
SERVICE_WAKE_LOCK_TTL=60s
# What Retry-After advertises to clients. A cold-start estimate, not a promise.
SERVICE_WAKE_RETRY_AFTER=15s

# --- Telemetry rollups ---
# OFF by default, and that default is load-bearing rather than cautious: with
# it off no telemetry middleware is registered, no collector is constructed, no
# ticker runs and nothing is published, so this build's request path is exactly
# what the previous one's was.
#
# With it on, the gateway aggregates {route template, method, status class}
# buckets in memory - never a raw path, which is what keeps the series count
# bounded - plus per-backend NATS round trips and Redis cache hits, and
# publishes one envelope per interval on myunivokai.events.telemetry.http.v1
# through JetStream. See notes/vision/telemetry-service-plan.md.
TELEMETRY_ENABLED=false
# How much traffic one envelope summarises, and the bucket width every chart is
# drawn at. An unclean kill loses at most one interval of counters - the
# accepted trade for telemetry, and the wrong one for anything billed.
TELEMETRY_FLUSH_INTERVAL=60s
