COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=41800
API_ALLOWED_ORIGINS=http://localhost:41300
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_gateway
NATS_PASSWORD=myunivokai_local_gateway
NATS_REQUEST_TIMEOUT=3s
NATS_PUBLISH_TIMEOUT=5s
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
REDIS_URL=redis://:myunivokai_local_redis@redis:6379/0
REDIS_KEY_PREFIX=myunivokai
RATE_LIMIT_REQUESTS_PER_SECOND=2
RATE_LIMIT_BURST=20
JOB_CACHE_TTL=30s
WORLD_CACHE_TTL=60s
SHARE_CACHE_TTL=60s
SERVICE_SHUTDOWN_TIMEOUT=15s

# --- Admin route group (/api/admin) ---
# Added late: the admin group landed in S4-AUTH-003 and this file never got
# its variables, so a standalone gateway run resolved ADMIN_ROUTES_ENABLED to
# the compose default (true) with an empty ADMIN_ACCESS_PUBLIC_KEYS — which
# fails config validation and stops the WHOLE gateway, product routes
# included. Set ADMIN_ROUTES_ENABLED=false if you only want the product API.
ADMIN_ROUTES_ENABLED=true
ADMIN_ALLOWED_ORIGIN=http://localhost:41900
ADMIN_RATE_LIMIT_REQUESTS_PER_SECOND=10
ADMIN_RATE_LIMIT_BURST=50
# Public half of the throwaway local-only seed committed as the
# AUTH_ACCESS_PRIVATE_KEY fallback in
# services/auth-service/docker-compose-local.yaml. Never valid in any
# deployed environment; rotate by listing keys comma-separated.
ADMIN_ACCESS_PUBLIC_KEYS=LevwVSKfMJY075I8dtGksiMif1pouqn7aisvsZPiARI=
ADMIN_TOKEN_VERSION_CACHE_TTL=360h

# --- Service wake (scale-to-zero hosting only) ---
# "none" locally: Docker containers do not sleep, so there is nothing to wake
# and a stopped service should still read as an outage rather than a cold
# start. See services/api-gateway/.env.example for the full block and
# notes/plans/architecture/service-wake-mechanism.md for the design.
SERVICE_WAKE_PLATFORM=none
SERVICE_WAKE_TIMEOUT=5s
SERVICE_WAKE_LOCK_TTL=60s
SERVICE_WAKE_RETRY_AFTER=15s
# NOTE: this file only applies when running api-gateway standalone from this
# directory (`docker compose -f docker-compose-local.yaml up` inside
# services/api-gateway). The full stack (`make local-up`, root
# docker-compose-local.yaml) interpolates from the root .env.local instead, so
# that file is the one that actually decides whether the admin Telemetry
# screens have anything to render. Kept true here for the same reason: local
# containers do not sleep and this data holds nothing sensitive.
TELEMETRY_ENABLED=true
TELEMETRY_FLUSH_INTERVAL=60s
