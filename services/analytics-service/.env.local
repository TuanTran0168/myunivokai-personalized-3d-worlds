COMPOSE_PROJECT_NAME=myunivokai-local
APP_ENV=development
DATABASE_URL=postgresql://myunivokai_analytics_app:myunivokai_local_analytics@postgres:5432/myunivokai_analytics?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_analytics_app:myunivokai_local_analytics@postgres:5432/myunivokai_analytics?sslmode=disable
DATABASE_MAX_CONNS=10
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_analytics
NATS_PASSWORD=myunivokai_local_analytics
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_QUERY_TIMEOUT=2500ms
NATS_ACK_WAIT=2m
NATS_FETCH_BATCH_SIZE=25
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s
SERVICE_SHUTDOWN_TIMEOUT=15s
