# =============================================================================
# Analytics Service — Environment File (.env.example)
# =============================================================================
# Used by services/analytics-service/docker-compose-local.yaml (standalone
# mode). When running via the root docker-compose-local.yaml these values are
# overridden by the root .env.local through Compose interpolation.
#
#   cp .env.example .env.local
#
# Note what is NOT here: no Redis URL, no signing key, no AI provider key.
# This service verifies no token, calls no provider and publishes no event —
# a credential appearing in this file would be a sign the read model had
# started doing something it is not allowed to do.
# =============================================================================

# --- App ---
APP_ENV=development

# --- Database ---
# PostgreSQL connection string for the myunivokai_analytics database.
# Use postgres:5432 inside Docker, localhost:15432 outside Docker.
DATABASE_URL=postgresql://myunivokai_analytics_app:myunivokai_local_analytics@postgres:5432/myunivokai_analytics?sslmode=disable
DATABASE_DIRECT_URL=postgresql://myunivokai_analytics_app:myunivokai_local_analytics@postgres:5432/myunivokai_analytics?sslmode=disable
DATABASE_MAX_CONNS=10

# --- NATS ---
# Use nats://nats:4222 inside Docker, nats://localhost:14222 outside Docker.
# This user may subscribe to myunivokai.events.> and
# myunivokai.queries.analytics.> and may publish no domain subject at all —
# the ACL in infra/nats/nats-server.conf enforces the read-model rule rather
# than trusting the code to honour it.
NATS_URL=nats://nats:4222
NATS_USERNAME=myunivokai_analytics
NATS_PASSWORD=myunivokai_local_analytics
NATS_CREDENTIALS=
NATS_CONNECT_TIMEOUT=5s
NATS_RECONNECT_WAIT=2s
NATS_QUERY_TIMEOUT=2500ms

# --- Event consumer ---
# A projection is one small upsert, so a larger fetch batch than the family
# services use is right here: it keeps the read model close to real time
# after a restart replays a backlog.
NATS_ACK_WAIT=2m
NATS_FETCH_BATCH_SIZE=25
NATS_FETCH_MAX_WAIT=1s
NATS_RETRY_DELAY=2s

# --- Service Lifecycle ---
SERVICE_SHUTDOWN_TIMEOUT=15s

# SERVICE_VERSION is what this process reports on
# myunivokai.events.<name>.service.started.v1, and what the admin Fleet screen
# shows. Left unset, a service falls back to Render's RENDER_GIT_COMMIT and then
# to the Go VCS stamp — which a container image does not carry, so a local run
# reports "unknown". `make local-up` exports the working tree's own
# `git describe --always --dirty` for exactly that reason.
SERVICE_VERSION=
